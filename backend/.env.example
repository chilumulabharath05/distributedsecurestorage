# ── Application ──────────────────────────────────────────────────────────────
PROJECT_NAME=CloudStore
VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-random-64-char-secret-key-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AES_ENCRYPTION_KEY=change-me-generate-a-random-32-byte-hex-encryption-key-here0

# ── Database (Neon PostgreSQL) ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-1.aws.neon.tech/cloudstore?sslmode=require

# ── Redis (Upstash) ───────────────────────────────────────────────────────
REDIS_URL=rediss://default:password@xxx.upstash.io:6379

# ── IPFS / Pinata ─────────────────────────────────────────────────────────
PINATA_JWT=eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.your_pinata_jwt_here
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ── File Limits ──────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=500
CHUNK_SIZE_BYTES=1048576

# ── CORS ─────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:3000,https://cloudstore.vercel.app

# ── Email (optional) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
EMAILS_FROM_EMAIL=noreply@cloudstore.io
